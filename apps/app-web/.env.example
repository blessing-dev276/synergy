# Firebase client config — from Firebase console > Project settings > Your apps > Web app.
# Not secret (Firebase client config is meant to be public), protection comes
# from Security Rules, but kept out of git for per-environment flexibility.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "false" to point a dev build at the real project instead of the
# Local Emulator Suite (see src/firebase.js).
VITE_USE_EMULATORS=true
